FROM golang:1.25.0-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/calendarsync-admin ./cmd/calendarsync-admin

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/calendarsync-admin /calendarsync-admin
ENTRYPOINT ["/calendarsync-admin"]
